#!/usr/bin/env bash
# Starts the Tallow project launcher (building it first if needed).
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
launcher="$root/build/Debug_Linux64/TallowLauncher/TallowLauncher"
if [[ ! -x "$launcher" ]]; then
	"$root/build.sh"
fi
export TALLOW_ROOT="$root"
exec "$launcher" "$@"
