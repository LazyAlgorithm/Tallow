<Project Sdk="Microsoft.NET.Sdk">
  <!-- The API a game's editor scripts (any folder named Editor under src/) build against: custom Inspectors, editor
       windows and menu commands. Loaded only by the editor, never shipped with a game. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tallow.API/Tallow.API.csproj" />
  </ItemGroup>
</Project>
