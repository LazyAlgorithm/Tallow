+// The C calling conventions of x86-64 (System V) and Apple's arm64 have the caller widen an 8- or 16-bit integer
+// argument to 32 bits, and code compiled by clang relies on it: zeroext/signext on the parameter, as clang marks them.
+inline BfIRAttribute BfIRGetIntExtendAttribute(BfTypeCode typeCode)
+{
+	switch (typeCode)
+	{
+	case BfTypeCode_Boolean:
+	case BfTypeCode_UInt8:
+	case BfTypeCode_UInt16:
+	case BfTypeCode_Char8:
+	case BfTypeCode_Char16:
+		return BfIRAttribute_ZExt;
+	case BfTypeCode_Int8:
+	case BfTypeCode_Int16:
+		return BfIRAttribute_SExt;
+	default:
+		return (BfIRAttribute)-1;
+	}
+}
