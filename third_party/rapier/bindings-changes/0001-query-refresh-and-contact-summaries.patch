+/// Bring scene queries up to date for bodies moved, teleported or created since the last step, without
+/// running collision detection: modified body poses are pushed to their colliders, and those bodies'
+/// colliders get their broad-phase AABBs refit in place. Change flags stay set, so the next step still
+/// handles pairs and solver bookkeeping. Much cheaper than rpr_detect_collisions when only queries need
+/// the new poses. Bodies that no longer exist are skipped.
+/// @ingroup worlds
+#[rapier_export]
+pub unsafe extern "C" fn rpr_refresh_queries_for_bodies(
+    world: *mut RprWorld,
+    bodies: *const RprRigidBodyHandle,
+    count: usize,
+) -> RprStatus {
+    ffi(|| unsafe {
+        if count > 0 && bodies.is_null() {
+            return Err(invalid("bodies is NULL with a nonzero count"));
+        }
+        let handles: &[RprRigidBodyHandle] =
+            if count == 0 { &[] } else { std::slice::from_raw_parts(bodies, count) };
+        for handle in handles {
+            handle.check_world(world)?;
+        }
+        let access = get(world)?.write()?;
+        let w = &mut (*access.raw()).0;
+        w.bodies
+            .propagate_modified_body_positions_to_colliders(&mut w.colliders);
+        let params = w.integration_parameters;
+        for handle in handles {
+            let Some(body) = w.bodies.get(handle.raw()) else {
+                continue;
+            };
+            for collider_handle in body.colliders() {
+                let Some(collider) = w.colliders.get(*collider_handle) else {
+                    continue;
+                };
+                if !collider.is_enabled() {
+                    continue;
+                }
+                let aabb = collider.compute_broad_phase_aabb(&params, &w.bodies);
+                if aabb.mins.is_finite() && aabb.maxs.is_finite() {
+                    w.broad_phase.set_aabb(&params, *collider_handle, aabb);
+                }
+            }
+        }
+        Ok(())
+    })
+}
