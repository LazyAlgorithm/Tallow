+/// One touching contact pair, summarized for game-side contact events in a single pass.
+/// @ingroup events
+#[repr(C)]
+#[derive(Copy, Clone, Default)]
+pub struct RprContactSummary {
+    /// First collider, in the narrow phase's order.
+    pub collider1: RprColliderHandle,
+    /// Second collider, in the narrow phase's order.
+    pub collider2: RprColliderHandle,
+    /// collider1's user data.
+    pub collider_user_data1: RprUserData,
+    /// collider2's user data.
+    pub collider_user_data2: RprUserData,
+    /// User data of collider1's parent body; zero without a parent.
+    pub body_user_data1: RprUserData,
+    /// User data of collider2's parent body; zero without a parent.
+    pub body_user_data2: RprUserData,
+    /// World-space point of the contact with the largest normal impulse, on collider1's surface.
+    pub point: RprVector,
+    /// World-space normal of that contact's manifold, from collider1 towards collider2.
+    pub normal: RprVector,
+    /// |(v2 - v1) . normal| at the point, from both parents' velocities; zero without both parents.
+    pub normal_speed: RprReal,
+    /// collider1 is a sensor.
+    pub sensor1: RprBool,
+    /// collider2 is a sensor.
+    pub sensor2: RprBool,
+    /// Both sides are fixed, sleeping, parentless or motionless kinematic.
+    pub resting: RprBool,
+    /// point/normal/normal_speed are filled (false for resting pairs when skipped, or pairs without points).
+    pub has_point: RprBool,
+}
+
+/// Summarize every contact pair with an active solver contact: colliders, user data, sensor flags, whether both
+/// sides rest, and (unless skip_resting_geometry is true and the pair rests) the strongest contact's point,
+/// normal and relative normal speed. One call instead of several per pair. Read-only.
+/// @see @ref output_buffers
+/// @ingroup events
+#[rapier_export]
+pub unsafe extern "C" fn rpr_active_contact_summaries(
+    world: *const RprWorld,
+    skip_resting_geometry: RprBool,
+    buffer: *mut RprContactSummary,
+    capacity: usize,
+) -> usize {
+    unsafe {
+        ffi_world_array(world, buffer, capacity, |count: *mut usize| {
+            ffi(|| {
+                let skip = boolean(skip_resting_geometry)?;
+                let access = get(world)?.read()?;
+                let w = &(*access.raw()).0;
+                let resting = |parent: Option<rapier::dynamics::RigidBodyHandle>| {
+                    parent.and_then(|h| w.bodies.get(h)).is_none_or(|rb| {
+                        rb.is_fixed()
+                            || rb.is_sleeping()
+                            || (rb.is_kinematic()
+                                && rb.linvel() == Default::default()
+                                && rb.angvel() == Default::default())
+                    })
+                };
+                let body_data = |parent: Option<rapier::dynamics::RigidBodyHandle>| {
+                    parent
+                        .and_then(|h| w.bodies.get(h))
+                        .map_or(RprUserData::default(), |rb| rb.user_data.into())
+                };
+                let mut out: Vec<RprContactSummary> = Vec::new();
+                for pair in w.narrow_phase.contact_pairs() {
+                    if !pair.has_any_active_contact() {
+                        continue;
+                    }
+                    let (Some(co1), Some(co2)) =
+                        (w.colliders.get(pair.collider1), w.colliders.get(pair.collider2))
+                    else {
+                        continue;
+                    };
+                    let parent1 = co1.parent();
+                    let parent2 = co2.parent();
+                    let mut summary = RprContactSummary {
+                        collider1: pair.collider1.into(),
+                        collider2: pair.collider2.into(),
+                        collider_user_data1: co1.user_data.into(),
+                        collider_user_data2: co2.user_data.into(),
+                        body_user_data1: body_data(parent1),
+                        body_user_data2: body_data(parent2),
+                        sensor1: co1.is_sensor() as RprBool,
+                        sensor2: co2.is_sensor() as RprBool,
+                        resting: (resting(parent1) && resting(parent2)) as RprBool,
+                        ..Default::default()
+                    };
+                    if !(skip && summary.resting != 0) {
+                        let mut best: Option<(Real, Vector, Vector)> = None;
+                        for manifold in pair.manifolds() {
+                            for point in &manifold.points {
+                                let impulse = point.data.impulse.abs();
+                                if best.is_none_or(|(b, _, _)| impulse > b) {
+                                    best = Some((impulse, point.local_p1, manifold.data.normal));
+                                }
+                            }
+                        }
+                        if let Some((_, local, normal)) = best {
+                            let at = co1.position() * local;
+                            let speed = match (
+                                parent1.and_then(|h| w.bodies.get(h)),
+                                parent2.and_then(|h| w.bodies.get(h)),
+                            ) {
+                                (Some(a), Some(b)) => {
+                                    (b.velocity_at_point(at) - a.velocity_at_point(at)).dot(normal).abs()
+                                }
+                                _ => 0.0,
+                            };
+                            summary.point = at.into();
+                            summary.normal = normal.into();
+                            summary.normal_speed = speed;
+                            summary.has_point = 1;
+                        }
+                    }
+                    out.push(summary);
+                }
+                copy_out(&out, buffer, capacity, count)
+            })
+        })
+    }
+}
